    "google-auth-library": "^10.9.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "libphonenumber-js": "^1.11.17",
    "mongodb": "^6.13.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.10.1",
    "pdf-parse": "^2.4.5",
    "rate-limit-redis": "^4.2.0",
    "redis": "^4.7.0",
    "ws": "^8.18.0"
