{
  "name": "blushy-auth-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node src/server.js",
    "dev:memorydb": "node scripts/dev_server_memorydb.js",
    "start": "node src/server.js",
    "test": "node --test --test-global-setup=./tests/helpers/globalSetup.js tests/*.test.js",
