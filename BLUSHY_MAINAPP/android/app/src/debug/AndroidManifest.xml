<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Cleartext HTTP, debug builds only.
         The app talks to http://127.0.0.1:3000 in development (see
         lib/services/api_base_url.dart, reached over `adb reverse`), which
         Android blocks by default. Declaring it here rather than in the main
         manifest keeps the permission out of release builds, where every
         request goes to https:// and unencrypted traffic should be refused. -->
    <application android:usesCleartextTraffic="true" />
</manifest>
